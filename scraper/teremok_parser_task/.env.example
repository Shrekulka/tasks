# Приклад конфігурації teremok_parser.
# Скопіюйте цей файл у .env і за потреби змініть значення.
# Усі змінні мають префікс TEREMOK_ (див. teremok_parser/config.py).
# Якщо .env відсутній або якесь поле не задане — застосовується значення за замовчуванням,
# вказане нижче в коментарі.

# --- Загальні ---
TEREMOK_APP_NAME=teremok-parser
TEREMOK_LOG_LEVEL=INFO
# TEREMOK_DEBUG=false                     # те саме, що прапорець --debug

# --- Джерело ---
TEREMOK_BASE_URL=https://teremok.org.ua
TEREMOK_SOURCE_TIMEZONE=Europe/Kyiv

# --- HTTP: таймаути, затримки між запитами, ретраї ---
TEREMOK_REQUEST_TIMEOUT=15.0
TEREMOK_REQUEST_DELAY_BASE=0.5
TEREMOK_REQUEST_DELAY_JITTER=0.3
TEREMOK_RETRY_TOTAL=3
TEREMOK_RETRY_BACKOFF_FACTOR=0.8
TEREMOK_MAX_CONSECUTIVE_ERRORS=8

# --- Відбір оголошень (див. README, розділ "Режими") ---
TEREMOK_TARGET_TOTAL=200
TEREMOK_MIN_PER_CATEGORY=10
TEREMOK_MIN_CATEGORIES_REQUIRED=5
TEREMOK_CANDIDATES_PER_CATEGORY=120
TEREMOK_MAX_PAGES_PER_CATEGORY=10

# --- Шляхи виводу ---
TEREMOK_OUTPUT_DIR=output
TEREMOK_LOG_DIR=logs
