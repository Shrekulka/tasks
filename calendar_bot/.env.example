# ──────────────── Telegram ────────────────
BOT_TOKEN=123456:AAExampleTokenHere
ADMIN_IDS=123456789,987654321

# ──────────────── PostgreSQL ────────────────
DB_NAME=calendar_bot
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=dbUser
DB_PASSWORD=dbPassword

# ──────────────── Google Calendar (Service Account) ────────────────
# Путь к JSON-ключу сервисного аккаунта (скачивается в Google Cloud Console)
GOOGLE_CREDENTIALS_FILE=credentials/service_account.json
# ID календаря, в который добавляются заявки.
# Для общего календаря компании — это email вида xxx@group.calendar.google.com
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
TIMEZONE=Europe/Kyiv

# За сколько минут до события слать напоминание (можно несколько через запятую)
REMINDER_OFFSETS_MINUTES=60,15
# Как часто проверять календарь на приближающиеся события (в секундах)
REMINDER_CHECK_INTERVAL=300

# ──────────────── Webhook (для ngrok при локальной разработке) ────────────────
# Локальный адрес, на котором aiohttp слушает запросы от Telegram
WEB_SERVER_HOST=0.0.0.0
WEB_SERVER_PORT=8080
WEBHOOK_PATH=/webhook
# Публичный URL от ngrok, например https://abcd-1234.ngrok-free.app
# Меняется при каждом перезапуске ngrok — обновляй перед стартом бота
WEBHOOK_BASE_URL=https://your-ngrok-id.ngrok-free.app
# Секрет для проверки заголовка X-Telegram-Bot-Api-Secret-Token
WEBHOOK_SECRET=change_me_to_random_string