DEBUG=True
SECRET_KEY=change-me          # при DEBUG=False обов'язково задайте інше, довге значення
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
LOG_LEVEL=DEBUG

# Необов'язково: AI-вердикт через OpenRouter (безкоштовні моделі).
# Ключі: key1,key2  або  ["key1","key2"]
OPENROUTER_API_KEYS=
# Моделі, які пробуються першими (через кому). Решта підтягується з OpenRouter автоматично.
OPENROUTER_MODELS=
# Моделі, які треба виключити
OPENROUTER_MODELS_BLOCKLIST=
OPENROUTER_TIMEOUT_SECONDS=20
# Загальний ліміт часу на всі спроби (має бути менше за timeout у gunicorn.conf.py)
OPENROUTER_DEADLINE_SECONDS=45

# Ніші, які не показувати на графіку головної (через кому)
NICHES_HIDDEN_ON_HOME=Other AI
