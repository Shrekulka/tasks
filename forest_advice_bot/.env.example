# Скопируйте в .env и заполните:  cp .env.example .env
# Файл .env в git НЕ попадает. Реальные значения здесь не хранить.

# ---------- Telegram ----------
# Токен бота от @BotFather, вид 123456789:AAAA...
TELEGRAM_BOT_TOKEN=

# ---------- PostgreSQL ----------
# Эти же три переменные использует и контейнер базы данных в docker-compose.
POSTGRES_DB=forest_advice
POSTGRES_USER=forest
# Значение для локальной разработки. На публичном сервере замените на свой пароль.
POSTGRES_PASSWORD=forest_dev_password
# Куда подключается бот. Локальный запуск: localhost. В docker-compose задаётся db.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------- LLM (бесплатные модели OpenRouter) ----------
# Ключ создаётся на openrouter.ai в разделе Keys, банковская карта не нужна.
# Можно несколько ключей через запятую: key1,key2. ВАЖНО: по правилам OpenRouter
# дополнительные ключи и аккаунты лимиты НЕ увеличивают (ёмкость считается глобально).
# Несколько ключей нужны только как страховка на случай отзыва одного из них.
# Не создавайте лишние аккаунты ради обхода лимитов.
# Ключ обязателен для запуска. Заглушки допустимы только в unit-тестах (tests/conftest.py).
LLM_API_KEYS=
# Запасной вариант для одного ключа: используется, только если LLM_API_KEYS пуст
LLM_API_KEY=
# Модели, которые пробуются первыми (через запятую, у бесплатных id заканчивается на :free).
# Остальные бесплатные бот находит сам по списку https://openrouter.ai/api/v1/models
LLM_MODELS=
# Модели, которые использовать нельзя (через запятую)
LLM_MODELS_BLOCKLIST=
# Адаптер провайдера. Сейчас поддерживается: openrouter
LLM_PROVIDER=openrouter
# Пусто = адрес по умолчанию из адаптера. Менять имеет смысл только вместе с адаптером.
LLM_BASE_URL=
# Минимальный контекст модели (токены) и время жизни списка моделей (секунды)
LLM_MIN_CONTEXT=8000
LLM_CATALOG_TTL_SECONDS=3600
# Пауза после общего лимита и после блокировки аккаунта (402), секунды
LLM_RATE_PAUSE_SECONDS=60
LLM_ACCOUNT_PAUSE_SECONDS=900
# На сколько отключать неверный или исчерпанный ключ, и модель (или пару «модель + ключ»), секунды
LLM_KEY_QUARANTINE_SECONDS=3600
LLM_MODEL_QUARANTINE_SECONDS=600
# Как долго верить закэшированному остатку дневной квоты провайдера, секунды
LLM_QUOTA_CACHE_SECONDS=30
# Запасной локальный лимит запросов в сутки (UTC), если провайдер не сообщает остаток. 0 = выключен
LLM_DAILY_REQUEST_LIMIT=0
# Сколько разных ключей должны получить отказ (403) от модели, чтобы отключить её целиком.
# Так модель, закрытая для вашего региона или аккаунта, не тратит по запросу на каждый ключ
LLM_PAIR_FAILURES_BEFORE_MODEL_QUARANTINE=2
# Параметры генерации: температура и потолок длины ответа, токены
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=600
# Сколько ответов 429 от поставщика терпим за один вопрос, затем общая пауза для всех (дальше попытки только тратят суточный лимит)
LLM_MAX_LIMITED_ATTEMPTS=2
# Длина общей паузы после исчерпания таких попыток, секунды (0 = без паузы)
LLM_LIMIT_PAUSE_SECONDS=60
# JSON-режим ответа: auto (включается, если модель заявила поддержку response_format) или off
LLM_JSON_MODE=auto
# Что делать, если ответ модели не прошёл проверку (JSON, язык): strict_retry = один повтор на той же модели
# с более строгим запросом, затем безопасное сообщение (так сказано в ТЗ); next_model = сразу следующая модель
LLM_INVALID_RESPONSE_STRATEGY=strict_retry
# На сколько секунд отключать модель после 429 её поставщика (учитывается и Retry-After; 0 = не отключать)
LLM_UPSTREAM_QUARANTINE_SECONDS=60
# Считать ли в локальный счётчик дневной квоты запросы без ответа: таймауты, 429, 5xx (консервативно: true)
LLM_COUNT_FAILED_REQUESTS=true
# Пауза от провайдера не короче этого значения считается исчерпанием дневного лимита, секунды
LLM_DAILY_RESET_THRESHOLD_SECONDS=3600
# Таймаут одного запроса, секунды
LLM_TIMEOUT_SECONDS=20
# Общий лимит времени на все попытки (не меньше таймаута одного запроса)
LLM_DEADLINE_SECONDS=45
# Сколько разных моделей максимум пробуем на один вопрос
LLM_MAX_MODELS_TRIED=3
# Потолок запросов к LLM в минуту на всех зверей.
# Реальные лимиты провайдера смотри в его документации:
# они могут изменяться и различаться для разных ограничений.
LLM_MAX_RPM=15

# ---------- Поиск по документам ----------
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Размерность вектора обязана совпадать с моделью (для multilingual-e5-base это 768)
EMBEDDING_DIM=768
# Префиксы для моделей семейства e5 (без них качество поиска падает без единой ошибки).
# Для моделей без префиксов оставьте значения пустыми. Пробел после префикса добавляет код.
EMBEDDING_QUERY_PREFIX=query:
EMBEDDING_PASSAGE_PREFIX=passage:
# Сколько текстов считать за один проход модели эмбеддингов
EMBEDDING_BATCH_SIZE=16
# Сколько фрагментов достаём из базы на один вопрос
TOP_K=5
# Во сколько раз больше кандидатов брать из БД, чем TOP_K (нужно, чтобы в ответ попали разные документы)
RETRIEVAL_CANDIDATE_FACTOR=4
# Потолок суммарного размера фрагментов в промпте, символы
MAX_CONTEXT_CHARS=6000
# Если индексация документа идёт дольше этого числа секунд, бот пишет «обробляю», а по окончании «готовий» (0 = всегда)
PROCESSING_NOTICE_AFTER_SECONDS=5
# Резерв к порогу по времени: документ с таким числом символов текста и больше считается большим, и «обробляю» уходит сразу (0 = выключено)
LARGE_DOCUMENT_CHARS=10000
# Язык ответов модели: код профиля из services/language.py (сейчас uk). Проверка языка отсекает, например, русский
ANSWER_LANGUAGE=uk
# Каталог текстов промптов (system.txt, strict_reminder.txt; свой промпт языка: <код>/system.txt, см. data/prompts/README.md)
PROMPTS_DIR=data/prompts
# Каталог JSON-профилей языков ответа (по файлу на язык, см. data/languages/README.md)
LANGUAGE_PROFILES_DIR=data/languages
# С какой длины ответа (в буквах) обязательны буквы языка ответа (для uk: і ї є ґ) или служебные слова языка
LANGUAGE_MARKER_MIN_CHARS=60
# Кэш ответов: время жизни (секунды, 0 = выключен) и число записей. Экономит дневную квоту LLM
ANSWER_CACHE_TTL_SECONDS=3600
ANSWER_CACHE_MAX_ENTRIES=500
# Максимальное косинусное расстояние, при котором фрагмент считается подходящим.
# Для multilingual-e5-base на живых вопросах лучшее расстояние у законных вопросов доходило
# до 0.243, поэтому порог свободный: лишнее отсеивает LLM (found=false). Подбор: scripts.eval_retrieval
RELEVANCE_THRESHOLD=0.25
# Дополнительный отсев шума: оставлять фрагменты не дальше лучшего + это значение.
# 0 = выключено. Пробуйте через: python -m scripts.eval_retrieval --margin 0.05
RELEVANCE_MARGIN=0
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
# Папка со стандартными документами на компьютере (для настоящего архива: ./archive)
ARCHIVE_HOST_DIR=./samples/archive

# Куда папка монтируется внутри контейнера Docker (только для чтения)
ARCHIVE_CONTAINER_DIR=/app/archive

# Путь к документам при локальном запуске без Docker
ARCHIVE_DIR=./samples/archive
# Лимит размера файла, МБ (не больше 20: боты не скачивают файлы крупнее)
MAX_FILE_MB=20
# Защита от тяжёлых файлов: страниц в PDF, записей в ZIP (DOCX), размер DOCX после распаковки, МБ
MAX_PDF_PAGES=500
MAX_ZIP_ENTRIES=2000
MAX_UNPACKED_MB=100

# ---------- Ограничения на одного пользователя ----------
UPLOADS_PER_HOUR=10
QUESTIONS_PER_MINUTE=6
MAX_QUESTION_CHARS=1000
# Документов на странице /mydocs и ожидание фоновых задач при остановке бота (секунды)
MYDOCS_PAGE_SIZE=5
SHUTDOWN_TIMEOUT_SECONDS=30

# ---------- Логи ----------
# DEBUG, INFO, WARNING, ERROR или CRITICAL
LOG_LEVEL=INFO
# auto = цвет только в терминале, 1 = всегда, 0 = никогда
LOG_COLOR=auto
# В Docker логи идут в консоль (docker compose logs), файл нужен только локально
LOG_TO_FILE=0
LOG_DIR=logs

# Часовой пояс дат в ответах бота (название из базы IANA)
DISPLAY_TIMEZONE=Europe/Kyiv
