# .env.example

# ─── LLM ПРОВАЙДЕР ────────────────────────────────────────────
# Выберите провайдера: claude | openai | deepseek
# Зачем выбор? Разные задачи — разная цена:
#   claude   — лучшее качество, $3/1M токенов
#   deepseek — 95% качества за $0.14/1M токенов (в 20 раз дешевле!)
DEFAULT_LLM_PROVIDER=claude

ANTHROPIC_API_KEY=sk-ant-api03-ВАШ_КЛЮЧ  # console.anthropic.com
CLAUDE_MODEL=claude-sonnet-4-20250514

OPENAI_API_KEY=sk-proj-ВАШ_КЛЮЧ          # platform.openai.com
OPENAI_MODEL=gpt-4o

DEEPSEEK_API_KEY=sk-ВАШ_КЛЮЧ             # platform.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ─── INSTAGRAM ────────────────────────────────────────────────
INSTAGRAM_MAX_POSTS=20        # Баланс точности и скорости: 20 постов = ~15 сек
INSTAGRAM_REQUEST_DELAY=2.0   # Меньше 1.0 → риск бана IP от Instagram
INSTAGRAM_USE_MOCK=false      # true = тестовые данные без реального скрапинга

# ─── СТРИМИНГОВЫЕ СЕРВИСЫ ─────────────────────────────────────
WATCHMODE_API_KEY=ВАШ_КЛЮЧ    # watchmode.com, бесплатно 1000 req/мес
USER_PLATFORMS=netflix,hbo    # env.list() парсит: "netflix,hbo" → ["netflix","hbo"]

# ─── ПРИЛОЖЕНИЕ ───────────────────────────────────────────────
DEBUG=false  # true = подробные логи (промпты, ответы LLM)